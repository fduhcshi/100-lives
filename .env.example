# ===== LLM 配置（三选一）=====
# 方式 1：Anthropic Messages 兼容网关（推荐）
LLM_BASE_URL=https://api.example.com
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name

# 方式 2：留空以上三项，程序会自动回退读取本机已设置的
#   ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY / ANTHROPIC_MODEL 环境变量

# 方式 3：开发/测试用内置 Mock（不需要任何密钥，输出为模板内容）
# LLM_MOCK=1

# ===== 运行参数（可选）=====
# 并发 LLM 请求数上限
MAX_CONCURRENCY=20
# 服务地址
HOST=127.0.0.1
PORT=8000
